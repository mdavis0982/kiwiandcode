---
/**
 * How it works: four steps from first chat to launch.
 * A kiwi-green line draws along the steps when the section scrolls into view.
 */
const steps = [
  {
    title: 'Chat',
    text: "Tell me about your business and what you need. Quotes are free, with no obligation.",
  },
  {
    title: 'Design',
    text: "Once we've agreed a plan, I put together a demo so you can see how your site will look and ask for changes.",
  },
  {
    title: 'Build',
    text: 'I build it properly: fast, mobile-friendly and set up with the basics search engines look for.',
  },
  {
    title: 'Launch',
    text: "Your site goes live on your own domain, and I'm still around afterwards for updates and help.",
  },
];
---

<section id="process" class="section theme-light" aria-labelledby="process-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">How it works</p>
      <h2 id="process-title">Four simple steps, start to finish</h2>
      <p>No long contracts or confusing tech talk. Just a clear path from first chat to a site you're happy with.</p>
    </div>

    <ol class="steps" data-reveal>
      {
        steps.map((step, i) => (
          <li class="step" style={`--i: ${i}`}>
            <span class="dot" aria-hidden="true">
              {i + 1}
            </span>
            <h3>
              <span class="visually-hidden">Step {i + 1}: </span>
              {step.title}
            </h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    --dot: 3rem;
    position: relative;
    display: grid;
    gap: var(--space-l);
    padding: 0;
    list-style: none;
  }

  /* The connecting line: vertical on mobile, horizontal on wide screens. */
  .steps::before,
  .steps::after {
    content: '';
    position: absolute;
    left: calc(var(--dot) / 2 - 1px);
    top: calc(var(--dot) / 2);
    bottom: calc(var(--dot) / 2);
    width: 2px;
    background: var(--line);
  }
  .steps::after {
    background: linear-gradient(var(--kiwi-deep), var(--kiwi));
    transform-origin: top;
  }

  .step {
    position: relative;
    padding-left: calc(var(--dot) + var(--space-m));
  }
  .dot {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--forest);
    color: var(--kiwi);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--step-1);
    box-shadow: 0 0 0 6px var(--bg);
    z-index: 1;
  }
  h3 {
    margin-bottom: 0.35rem;
    padding-top: 0.55rem;
  }
  .step p {
    color: var(--muted);
  }

  @media (min-width: 56rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-m);
    }
    .steps::before,
    .steps::after {
      left: calc(var(--dot) / 2);
      /* End at the centre of the last dot. */
      right: calc(25% - 0.75 * var(--space-m) - var(--dot) / 2);
      top: calc(var(--dot) / 2 - 1px);
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .steps::after {
      background: linear-gradient(90deg, var(--kiwi-deep), var(--kiwi));
      transform-origin: left;
    }
    .step {
      padding-left: 0;
      padding-top: calc(var(--dot) + var(--space-m));
    }
    h3 {
      padding-top: 0;
    }
  }

  /* Line draws in and the dots pop as the list is revealed. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .steps[data-reveal] {
      opacity: 1;
      transform: none;
    }
    :global(.js) .steps::after {
      transform: scale(1, 0);
      transition: transform 1.6s var(--ease-out) 0.2s;
    }
    :global(.js) .steps .step {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.6s var(--ease-out);
      transition-delay: calc(0.2s + var(--i) * 0.35s);
    }
    :global(.js) .steps .dot {
      transform: scale(0.4);
      transition: transform 0.6s var(--ease-spring);
      transition-delay: calc(0.2s + var(--i) * 0.35s);
    }
    :global(.js) .steps:global(.is-visible)::after {
      transform: none;
    }
    :global(.js) .steps:global(.is-visible) .step {
      opacity: 1;
      transform: none;
    }
    :global(.js) .steps:global(.is-visible) .dot {
      transform: none;
    }
  }
  @media (min-width: 56rem) and (prefers-reduced-motion: no-preference) {
    :global(.js) .steps::after {
      transform: scale(0, 1);
    }
  }
</style>
