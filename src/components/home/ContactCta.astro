---
/**
 * Contact call to action: a button to the contact form, plus the email
 * address with a copy button for people who'd rather email.
 */
import LogoMark from '../LogoMark.astro';
import { links, site } from '../../data/site';
---

<section id="contact" class="section theme-dark contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="panel" data-reveal>
      <div class="panel-art" aria-hidden="true">
        <LogoMark class="panel-mark" />
      </div>

      <div class="panel-copy">
        <p class="eyebrow">Get in touch</p>
        <h2 id="contact-title">Got a project in mind, or just a question?</h2>
        <p class="sub">
          Send me a message and tell me a bit about your business. Quotes are free and there's no obligation, so it
          costs nothing to ask.
        </p>

        <div class="actions">
          <a class="btn btn--big" href={links.contact}>
            Send a message
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"
              ><path d="M4 10h11m-4-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              ></path></svg
            >
          </a>
          <button class="copy" type="button" data-copy={site.email}>
            <span class="copy-email">{site.email}</span>
            <span class="copy-hint">Copy</span>
          </button>
        </div>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

<script>
  // "Copy" button: puts the email address on the clipboard and confirms it.
  const button = document.querySelector<HTMLButtonElement>('.contact [data-copy]');
  const status = document.querySelector('.contact .copy-status');
  const hint = button?.querySelector('.copy-hint');

  button?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      if (hint) hint.textContent = 'Copied!';
      if (status) status.textContent = 'Email address copied to clipboard.';
      button.classList.add('is-copied');
      setTimeout(() => {
        if (hint) hint.textContent = 'Copy';
        button.classList.remove('is-copied');
      }, 2000);
    } catch {
      // Clipboard blocked: the address is still visible to copy by hand.
      if (status) status.textContent = 'Copying failed. The address is shown on the button.';
    }
  });
</script>

<style>
  .contact {
    padding-top: var(--space-l);
  }
  .panel {
    position: relative;
    overflow: hidden;
    padding: var(--space-xl) var(--space-m);
    border: 1px solid var(--ink-line);
    border-radius: 2rem;
    background:
      radial-gradient(ellipse 70% 90% at 100% 0%, rgb(155 225 93 / 0.22), transparent 60%),
      radial-gradient(ellipse 60% 70% at 0% 100%, rgb(255 122 89 / 0.25), transparent 60%),
      var(--ink-raised);
    isolation: isolate;
  }

  /* Big kiwi mark peeking out of the corner, slowly turning. */
  .panel-art {
    position: absolute;
    right: -9rem;
    bottom: -7rem;
    width: 26rem;
    opacity: 0.18;
    z-index: -1;
  }
  .panel-art :global(.panel-mark .km-mark) {
    transform-box: fill-box;
    transform-origin: center;
  }

  .panel-copy {
    max-width: 40rem;
  }
  .sub {
    margin-top: var(--space-s);
    font-size: var(--step-1);
    color: var(--mist);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }
  .btn--big {
    min-height: 3.5rem;
    padding-inline: 2rem;
    font-size: var(--step-1);
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    max-width: 100%;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    border: 1px solid var(--ink-line);
    border-radius: 999px;
    background: rgb(13 27 20 / 0.6);
    color: var(--chalk);
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .copy:hover {
    border-color: var(--kiwi);
  }
  .copy-email {
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.65rem + 0.5vw, 0.94rem);
    white-space: nowrap;
  }
  .copy-hint {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--ink-line);
    font-size: var(--step--1);
    font-weight: 600;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .copy:global(.is-copied) .copy-hint {
    background: var(--kiwi);
    color: var(--ink);
  }
  .copy-status {
    min-height: 1.5em;
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--mist);
  }

  @media (min-width: 48rem) {
    .panel {
      padding-inline: var(--space-xl);
    }
    .panel-art {
      right: -11rem;
      bottom: auto;
      top: 50%;
      translate: 0 -50%;
      width: 32rem;
      opacity: 0.22;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel-art :global(.panel-mark .km-mark) {
      animation: turn 40s linear infinite;
    }
  }
  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }
</style>
