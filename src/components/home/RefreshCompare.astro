---
/**
 * Website refresh demo: a before/after slider over two versions of the same
 * made-up café homepage. Both "screenshots" are plain HTML scaled with
 * container query units, so there are no images to load.
 *
 * The control is a native range input stretched over the stage, so it works
 * with the keyboard and screen readers out of the box. A little script adds
 * drag-anywhere on touch screens and a one-off nudge to show it moves.
 */
import '@fontsource-variable/fraunces/wght.css';
---

<section class="section theme-light refresh" aria-labelledby="refresh-title">
  <div class="container refresh-grid">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Website refreshes</p>
      <h2 id="refresh-title">Same business, fresh new look</h2>
      <p>
        Drag the handle to compare a tired old homepage with a refreshed one. The café is made up, just to show the
        idea.
      </p>
    </div>

    <div class="compare" data-compare data-reveal style="--p: 50">
      <div class="stage" aria-hidden="true">
        <!-- ---------- Before: the dated site ---------- -->
        <div class="shot before">
          <div class="b-banner">~*~ Welcome to Beans &amp; Bites Caf&eacute;!!! ~*~</div>
          <div class="b-nav">
            <u>Home</u> | <u>Our Menu</u> | <u>Contact Us</u> | <u>Guestbook</u>
          </div>
          <div class="b-body">
            <div class="b-box">
              <p class="b-title">About Us</p>
              <p>
                We are a family run cafe serving tea, coffee, sandwiches and home baking. Please see our menu page for
                prices. Click <u>here</u> to email us.
              </p>
              <p class="b-construct">&#9888; Menu page under construction &#9888;</p>
            </div>
            <div class="b-photo">[ photo ]</div>
          </div>
          <p class="b-foot">Best viewed in 800 x 600 &middot; Last updated: ages ago</p>
        </div>

        <!-- ---------- After: the refreshed site ---------- -->
        <div class="shot after">
          <div class="a-nav">
            <span class="a-logo">Beans <em>&amp;</em> Bites</span>
            <span class="a-links"><span>Menu</span><span>Visit</span></span>
            <span class="a-btn a-btn--small">Order ahead</span>
          </div>
          <div class="a-hero">
            <div>
              <p class="a-kicker">Caf&eacute; &middot; open today</p>
              <p class="a-title">Good coffee, <em>made slowly.</em></p>
              <p class="a-text">Fresh bakes and proper coffee on the corner.</p>
              <span class="a-btn">See the menu</span>
            </div>
            <div class="a-cup">
              <i class="a-steam"></i>
              <i class="a-steam"></i>
              <i class="a-saucer"></i>
              <i class="a-mug"></i>
            </div>
          </div>
        </div>

        <!-- Labels and the divider handle -->
        <span class="tag tag--before">Before</span>
        <span class="tag tag--after">After</span>
        <span class="handle">
          <svg viewBox="0 0 24 24"><path d="M9 6l-5 6 5 6M15 6l5 6-5 6" /></svg>
        </span>
      </div>

      <label class="visually-hidden" for="refresh-range">
        Compare the old and refreshed café homepage. Left shows more of the old site, right shows more of the new one.
      </label>
      <input
        id="refresh-range"
        class="range"
        type="range"
        min="0"
        max="100"
        value="50"
        aria-valuetext="Half and half"
      />
    </div>
  </div>
</section>

<script>
  // Keep the --p custom property (0-100) in step with the slider, add
  // drag-anywhere for touch, and nudge the handle once to show it moves.
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((compare) => {
    const range = compare.querySelector<HTMLInputElement>('.range');
    if (!range) return;

    const describe = (p: number) =>
      p < 10 ? 'Showing the old site' : p > 90 ? 'Showing the refreshed site' : `${p}% refreshed`;
    const set = (p: number) => {
      const value = Math.round(Math.min(100, Math.max(0, p)));
      range.value = String(value);
      range.setAttribute('aria-valuetext', describe(value));
      compare.style.setProperty('--p', String(value));
    };
    let touched = false;
    range.addEventListener('input', () => {
      touched = true;
      set(Number(range.value));
    });

    // Drag from anywhere on the picture, not just the thumb (iOS only drags the thumb).
    const fromPointer = (event: PointerEvent) => {
      const box = range.getBoundingClientRect();
      set(((event.clientX - box.left) / box.width) * 100);
    };
    range.addEventListener('pointerdown', (event) => {
      touched = true;
      range.setPointerCapture(event.pointerId);
      fromPointer(event);
    });
    range.addEventListener('pointermove', (event) => {
      if (range.hasPointerCapture(event.pointerId)) fromPointer(event);
    });

    // One gentle sweep the first time it scrolls into view.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        const start = performance.now();
        const duration = 1600;
        const step = (now: number) => {
          if (touched) return;
          const t = Math.min(1, (now - start) / duration);
          // 50 -> 30 -> 70 -> 50.
          set(50 - Math.sin(t * Math.PI * 2) * 20);
          if (t < 1) requestAnimationFrame(step);
          else set(50);
        };
        setTimeout(() => requestAnimationFrame(step), 500);
      },
      { threshold: 0.6 },
    );
    observer.observe(compare);
  });
</script>

<style>
  .refresh {
    padding-top: 0;
  }

  .compare {
    /* Divider position. Range thumbs travel between half a thumb from each edge, so match that. */
    --x: calc(var(--p) * (100cqi - 2.75rem) / 100 + 1.375rem);
    position: relative;
    container-type: inline-size;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 11;
  }

  /* Wide screens: copy on the left, the comparison on the right. */
  @media (min-width: 56rem) {
    .refresh-grid {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      align-items: center;
      gap: var(--space-l);
    }
    .refresh-grid .section-head {
      margin-bottom: 0;
    }
  }
  .shot {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  /* The refreshed site sits on top, cut away left of the divider. */
  .after {
    clip-path: inset(0 0 0 var(--x));
  }

  /* ---------- Before ---------- */
  .shot {
    display: flex;
    flex-direction: column;
  }
  .before {
    padding: 2cqi;
    background:
      repeating-linear-gradient(45deg, #c9d6df 0 1.2cqi, #b8c7d1 1.2cqi 2.4cqi);
    color: #000;
    font-family: 'Times New Roman', Times, serif;
    font-size: 2.6cqi;
    line-height: 1.25;
  }
  .b-banner {
    padding: 1.5cqi;
    border: 0.5cqi ridge #999;
    background: #ffff66;
    color: #d40000;
    font-family: 'Comic Sans MS', 'Comic Neue', cursive;
    font-size: 4.2cqi;
    font-weight: 700;
    text-align: center;
  }
  .b-nav {
    margin: 1.2cqi 0;
    padding: 0.8cqi;
    background: #000080;
    color: #fff;
    text-align: center;
  }
  .b-nav u,
  .b-box u {
    color: #00f;
  }
  .b-nav u {
    color: #9cf;
  }
  .b-body {
    flex: 1;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    align-items: start;
    gap: 1.5cqi;
  }
  .b-box {
    padding: 1.5cqi;
    border: 0.3cqi solid #666;
    background: #fff;
  }
  .b-box p + p {
    margin-top: 1cqi;
  }
  .b-title {
    color: #800080;
    font-size: 3.4cqi;
    font-weight: 700;
    text-decoration: underline;
  }
  .b-construct {
    padding: 0.6cqi;
    background: repeating-linear-gradient(-45deg, #ffcc00 0 1cqi, #000 1cqi 2cqi);
    color: #fff;
    font-weight: 700;
    text-align: center;
    text-shadow: 0 0 0.4cqi #000;
  }
  .b-photo {
    display: grid;
    align-self: stretch;
    margin-bottom: 1.5cqi;
    place-items: center;
    border: 0.4cqi inset #999;
    background: #ddd;
    color: #777;
    font-style: italic;
  }
  .b-foot {
    margin-top: 1.5cqi;
    color: #333;
    font-size: 2cqi;
    text-align: center;
  }

  /* ---------- After ---------- */
  .after {
    padding: 3cqi 4.5cqi;
    background:
      radial-gradient(50cqi 40cqi at 85% 70%, rgb(217 105 63 / 0.16), transparent 70%),
      #f7efe3;
    color: #2b1d16;
    font-family: var(--font-body);
  }
  .a-nav {
    display: flex;
    align-items: center;
    gap: 3cqi;
    margin-bottom: 5cqi;
  }
  .a-logo {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: 3.4cqi;
    font-weight: 700;
    white-space: nowrap;
  }
  .a-logo em,
  .a-title em {
    color: #d9693f;
    font-style: italic;
  }
  .a-links {
    display: flex;
    gap: 2.5cqi;
    margin-left: auto;
    font-size: 2cqi;
    font-weight: 500;
  }
  .a-btn {
    display: inline-block;
    padding: 1.3cqi 2.8cqi;
    border-radius: 999px;
    background: #2b1d16;
    color: #f7efe3;
    font-size: 2.2cqi;
    font-weight: 600;
    white-space: nowrap;
  }
  .a-btn--small {
    padding: 1cqi 2.2cqi;
    font-size: 1.8cqi;
  }
  .a-hero {
    flex: 1;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 3cqi;
  }
  .a-kicker {
    margin-bottom: 1.2cqi;
    color: #8a5a3c;
    font-size: 1.9cqi;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .a-title {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: 7.4cqi;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .a-text {
    margin: 2cqi 0 3cqi;
    color: #5c4636;
    font-size: 2.3cqi;
  }
  .a-cup {
    position: relative;
    aspect-ratio: 1;
  }
  .a-cup i {
    position: absolute;
  }
  .a-saucer {
    left: 8%;
    right: 8%;
    bottom: 14%;
    height: 12%;
    border-radius: 50%;
    background: #e3d3bf;
    box-shadow: 0 2cqi 3cqi -1cqi rgb(43 29 22 / 0.3);
  }
  .a-mug {
    left: 24%;
    right: 24%;
    bottom: 20%;
    height: 42%;
    border-radius: 0 0 40% 40% / 0 0 30% 30%;
    background: linear-gradient(90deg, #d9693f, #e8875f 45%, #c55a32);
  }
  .a-mug::after {
    content: '';
    position: absolute;
    right: -22%;
    top: 18%;
    width: 30%;
    height: 42%;
    border: 1.4cqi solid #c55a32;
    border-left: 0;
    border-radius: 0 50% 50% 0;
  }
  .a-steam {
    bottom: 66%;
    width: 1.2cqi;
    height: 16%;
    border-radius: 999px;
    background: linear-gradient(transparent, rgb(43 29 22 / 0.25));
  }
  .a-steam:first-child {
    left: 42%;
  }
  .a-steam:nth-child(2) {
    left: 54%;
    height: 12%;
  }

  /* ---------- Divider, handle and labels ---------- */
  .handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--kiwi);
    box-shadow: 0 0 0 1px rgb(13 27 20 / 0.35);
    translate: calc(var(--x) - 1px) 0;
    pointer-events: none;
  }
  .handle svg {
    position: absolute;
    max-width: none;
    top: 50%;
    left: 50%;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.6rem;
    border-radius: 50%;
    background: var(--kiwi);
    color: var(--ink);
    box-shadow: 0 6px 18px -6px rgb(13 27 20 / 0.6);
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    translate: -50% -50%;
    transition: scale 0.25s var(--ease-spring);
  }
  .tag {
    position: absolute;
    bottom: 0.75rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgb(13 27 20 / 0.85);
    color: var(--chalk);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .tag--before {
    left: 0.75rem;
  }
  .tag--after {
    right: 0.75rem;
    background: var(--kiwi);
    color: var(--ink);
  }

  /* The real control: invisible, stretched over the stage, thumb as tall as it. */
  .range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
  }
  .range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 2.75rem;
    height: 100vh;
  }
  .range::-moz-range-thumb {
    width: 2.75rem;
    height: 100%;
    border: 0;
  }
  .compare:has(.range:hover) .handle svg,
  .compare:has(.range:active) .handle svg {
    scale: 1.1;
  }
  /* Show focus on the visible frame, since the input itself is invisible. */
  .compare:has(.range:focus-visible) {
    outline: 3px solid var(--leaf);
    outline-offset: 3px;
  }
</style>
