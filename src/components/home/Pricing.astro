---
/**
 * Prices and contact, together at the end of the homepage: the founding
 * offer banner, the three packages, the care plans and a short contact strip.
 * Prices come from src/data/pricing.ts.
 */
import LogoMark from '../LogoMark.astro';
import { links, site } from '../../data/site';
import { packages, carePlans, offer, offerPrice, formatPrice, showOffer } from '../../data/pricing';
---

<section id="pricing" class="section theme-dark pricing" aria-labelledby="pricing-title">
  <div class="container">
    <div class="head" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Prices</p>
        <h2 id="pricing-title">Simple prices, no surprises</h2>
        <p>
          Every project starts with a free chat and a free mock-up of your homepage, before you pay a penny.
        </p>
      </div>

      {
        showOffer && (
          <div class="offer">
            <span class="offer-badge">Founding offer</span>
            <p class="offer-text">
              <strong>{offer.percent}% off any package</strong> for my first {offer.spotsTotal} clients, in return for an
              honest review and permission to show your site.
            </p>
            <p class="offer-spots">
              <span class="pips" aria-hidden="true">
                {Array.from({ length: offer.spotsTotal }, (_, i) => (
                  <span class:list={['pip', { 'is-free': i < offer.spotsLeft }]} />
                ))}
              </span>
              {offer.spotsLeft} of {offer.spotsTotal} places left
            </p>
          </div>
        )
      }
    </div>

    <ul class="plans">
      {
        packages.map((pkg, i) => (
          <li class:list={['plan', { 'is-popular': pkg.popular }]} data-reveal style={`--delay: ${i * 90}ms`}>
            <div class="plan-top">
              <h3>{pkg.name}</h3>
              {pkg.popular && <span class="popular">Most popular</span>}
            </div>
            <p class="price">
              <span class="from">from</span>
              {showOffer ? (
                <>
                  <del>
                    <span class="visually-hidden">was </span>
                    {formatPrice(pkg.price)}
                  </del>
                  <span class="now">
                    <span class="visually-hidden">now </span>
                    {formatPrice(offerPrice(pkg.price))}
                  </span>
                </>
              ) : (
                <span class="now">{formatPrice(pkg.price)}</span>
              )}
            </p>
            <p class="best">{pkg.bestFor}</p>
            <ul class="features">
              {pkg.features.map((feature) => (
                <li>
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m5 10.5 3 3 7-7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <div class="care" data-reveal>
      <div class="care-intro">
        <h3>Care plans</h3>
        <p>Optional upkeep so your site stays secure and current. Cancel any time with a month's notice.</p>
      </div>
      <ul class="care-list">
        {
          carePlans.map((plan) => (
            <li>
              <p class="care-name">
                {plan.name} <span class="care-price">{formatPrice(plan.monthly)}<small>/month</small></span>
              </p>
              <p class="care-text">{plan.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div id="contact" class="panel" data-reveal>
      <div class="panel-art" aria-hidden="true">
        <LogoMark class="panel-mark" />
      </div>
      <div class="panel-copy">
        <h3>Got a project in mind, or just a question?</h3>
        <p>Quotes are free and there's no obligation.</p>
      </div>
      <div class="actions">
        <a class="btn btn--big" href={links.contact}>
          Get a free quote
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"
            ><path d="M4 10h11m-4-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ></path></svg
          >
        </a>
        <button class="copy" type="button" data-copy={site.email}>
          <span class="copy-email">{site.email}</span>
          <span class="copy-hint">Copy</span>
        </button>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

<script>
  // "Copy" button: puts the email address on the clipboard and confirms it.
  const button = document.querySelector<HTMLButtonElement>('.pricing [data-copy]');
  const status = document.querySelector('.pricing .copy-status');
  const hint = button?.querySelector('.copy-hint');

  button?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      if (hint) hint.textContent = 'Copied!';
      if (status) status.textContent = 'Email address copied to clipboard.';
      button.classList.add('is-copied');
      setTimeout(() => {
        if (hint) hint.textContent = 'Copy';
        button.classList.remove('is-copied');
      }, 2000);
    } catch {
      // Clipboard blocked: the address is still visible to copy by hand.
      if (status) status.textContent = 'Copying failed. The address is shown on the button.';
    }
  });
</script>

<style>
  .head .section-head {
    margin-bottom: var(--space-m);
  }

  /* ---------- Founding offer banner ---------- */
  .offer {
    position: relative;
    display: grid;
    gap: 0.4rem 1rem;
    padding: 1rem 1.1rem;
    margin-bottom: var(--space-l);
    border: 1px solid rgb(255 122 89 / 0.45);
    border-radius: var(--radius);
    background: linear-gradient(100deg, rgb(255 122 89 / 0.2), rgb(255 122 89 / 0.06) 70%), var(--ink-raised);
    overflow: hidden;
  }
  .offer-badge {
    justify-self: start;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--coral);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .offer-text {
    color: var(--chalk);
  }
  .offer-text strong {
    color: var(--peach);
  }
  .offer-spots {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--mist);
  }
  .pips {
    display: inline-flex;
    gap: 0.3rem;
  }
  .pip {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1.5px solid var(--peach);
  }
  .pip.is-free {
    background: var(--coral);
    border-color: var(--coral);
  }

  /* ---------- Packages ---------- */
  .plans {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }
  /* Phone: compact rows, name on the left and price on the right. */
  .plan {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0 var(--space-s);
    padding: 1rem 1.1rem;
    border: 1px solid var(--ink-line);
    border-radius: var(--radius);
    background: var(--ink-raised);
    transition:
      transform 0.4s var(--ease-out),
      border-color 0.3s;
  }
  .plan.is-popular {
    border-color: var(--kiwi);
    background: radial-gradient(ellipse 90% 60% at 100% 0%, rgb(155 225 93 / 0.14), transparent 70%), var(--ink-raised);
  }
  .plan-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 0.5rem;
  }
  .best {
    display: none;
  }
  .plan h3 {
    font-size: var(--step-1);
  }
  .popular {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--kiwi);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 700;
    white-space: nowrap;
  }

  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 0.5rem;
  }
  .from {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--mist);
  }
  .price del {
    font-size: var(--step-0);
    color: var(--mist);
    text-decoration-color: var(--coral);
    text-decoration-thickness: 2px;
  }
  .now {
    font-family: var(--font-heading);
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1;
    color: var(--chalk);
    font-variant-numeric: tabular-nums;
  }
  /* Phone: features as one short dotted line under the name and price. */
  .features {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.4rem;
    margin-top: 0.4rem;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--mist);
  }
  .features li:not(:last-child)::after {
    content: '·';
    margin-left: 0.4rem;
    color: var(--kiwi);
  }
  .features svg {
    display: none;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.1rem;
    fill: none;
    stroke: var(--kiwi);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Care plans ---------- */
  .care {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-s);
    padding: 1rem 1.1rem;
    border: 1px dashed var(--ink-line);
    border-radius: var(--radius);
  }
  .care h3 {
    font-size: var(--step-1);
  }
  .care-intro p {
    margin-top: 0.25rem;
    color: var(--mist);
    font-size: var(--step--1);
  }
  .care-list {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }
  .care-name {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-weight: 700;
  }
  .care-price {
    font-family: var(--font-heading);
    color: var(--lime);
  }
  .care-price small {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--mist);
  }
  .care-text {
    color: var(--mist);
    font-size: var(--step--1);
  }

  /* ---------- Contact strip ---------- */
  .panel {
    position: relative;
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-m);
    padding: var(--space-m) 1.1rem;
    border: 1px solid var(--ink-line);
    border-radius: 1.5rem;
    background:
      radial-gradient(ellipse 70% 90% at 100% 0%, rgb(155 225 93 / 0.22), transparent 60%),
      radial-gradient(ellipse 60% 70% at 0% 100%, rgb(255 122 89 / 0.25), transparent 60%),
      var(--ink-raised);
    overflow: hidden;
    isolation: isolate;
  }
  .panel-art {
    position: absolute;
    right: -7rem;
    bottom: -6rem;
    width: 18rem;
    opacity: 0.14;
    z-index: -1;
  }
  .panel-art :global(.panel-mark .km-mark) {
    transform-box: fill-box;
    transform-origin: center;
  }
  .panel h3 {
    font-size: var(--step-2);
  }
  .panel-copy p {
    margin-top: var(--space-xs);
    color: var(--mist);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
  }
  .btn--big {
    min-height: 3.5rem;
    padding-inline: 2rem;
    font-size: var(--step-1);
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    max-width: 100%;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    border: 1px solid var(--ink-line);
    border-radius: 999px;
    background: rgb(13 27 20 / 0.6);
    color: var(--chalk);
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .copy:hover {
    border-color: var(--kiwi);
  }
  .copy-email {
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.65rem + 0.5vw, 0.94rem);
    white-space: nowrap;
  }
  .copy-hint {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--ink-line);
    font-size: var(--step--1);
    font-weight: 600;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .copy:global(.is-copied) .copy-hint {
    background: var(--kiwi);
    color: var(--ink);
  }
  .copy-status {
    flex-basis: 100%;
    min-height: 1.5em;
    font-size: var(--step--1);
    color: var(--mist);
  }
  .copy-status:empty {
    display: none;
  }

  /* ---------- Wider screens ---------- */
  @media (min-width: 40rem) {
    .care-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-m);
    }
    .offer {
      grid-template-columns: auto 1fr auto;
      align-items: center;
    }
  }

  @media (min-width: 56rem) {
    .head {
      display: grid;
      grid-template-columns: 1fr 22rem;
      gap: var(--space-l);
      align-items: end;
      margin-bottom: var(--space-l);
    }
    .head .section-head {
      margin-bottom: 0;
    }
    .offer {
      grid-template-columns: 1fr;
      margin-bottom: 0;
      padding: 1.25rem 1.4rem;
    }
    .plans {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-m);
    }
    .plan {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-m);
    }
    .price {
      justify-content: flex-start;
      margin-top: 0.35rem;
    }
    .now {
      font-size: var(--step-3);
    }
    .best {
      display: block;
      margin-top: 0.5rem;
      color: var(--mist);
      font-size: var(--step--1);
    }
    .features {
      display: grid;
      gap: 0.3rem;
      margin-top: var(--space-s);
      padding-top: var(--space-s);
      border-top: 1px solid var(--ink-line);
      color: var(--chalk);
    }
    .features li {
      display: flex;
      gap: 0.45rem;
      align-items: flex-start;
    }
    .features li::after {
      display: none;
    }
    .features svg {
      display: block;
    }
    .plan:hover {
      transform: translateY(-6px);
      border-color: var(--kiwi);
    }
    .plan.is-popular {
      box-shadow: 0 0 0 1px var(--kiwi), 0 24px 60px -30px rgb(155 225 93 / 0.5);
    }
    .care {
      grid-template-columns: 16rem 1fr;
      align-items: center;
      gap: var(--space-l);
    }
    .panel {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-l);
      padding: var(--space-l);
    }
    .panel-art {
      right: auto;
      left: 50%;
      top: 50%;
      bottom: auto;
      translate: 0 -50%;
      width: 22rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel-art :global(.panel-mark .km-mark) {
      animation: turn 40s linear infinite;
    }
    /* Desktop only: the free places gently pulse. */
    @media (min-width: 56rem) {
      .pip.is-free {
        animation: pulse 2.4s ease-in-out infinite;
      }
    }
  }
  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 4px rgb(255 122 89 / 0.25);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plan {
      transition: none;
    }
  }
</style>
