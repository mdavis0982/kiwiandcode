---
/**
 * The full price list: founding offer banner, the three packages and the
 * care plans. Used on the /pricing/ page. Prices come from src/data/pricing.ts.
 *
 * On desktop, a soft kiwi glow follows the cursor around each card's border.
 */
import { packages, carePlans, offer, offerPrice, formatPrice, showOffer } from '../../data/pricing';

interface Props {
  /** 1 when this is the main heading of the page. */
  level?: 1 | 2;
}
const { level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
const Sub = level === 1 ? 'h2' : 'h3';
---

<section id="pricing" class="section theme-dark pricing" aria-labelledby="pricing-title">
  <div class="container">
    <div class="head" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Prices</p>
        <Heading id="pricing-title" class="wipe">
          <span style="--i: 0">Simple prices,</span>
          <span style="--i: 1">no surprises</span>
        </Heading>
        <p>
          These are starting prices, not fixed ones. Every business is different, so I quote each project on what you
          actually need, after a free chat and a free mock-up of your homepage.
        </p>
      </div>

      {
        showOffer && (
          <div class="offer">
            <span class="offer-badge">Founding offer</span>
            <p class="offer-text">
              <strong>{offer.percent}% off any package</strong> for my first {offer.spotsTotal} clients, in return for an
              honest review and permission to show your site.
            </p>
            <p class="offer-spots">
              <span class="pips" aria-hidden="true">
                {Array.from({ length: offer.spotsTotal }, (_, i) => (
                  <span class:list={['pip', { 'is-free': i < offer.spotsLeft }]} />
                ))}
              </span>
              {offer.spotsLeft} of {offer.spotsTotal} places left
            </p>
          </div>
        )
      }
    </div>

    <ul class="plans">
      {
        packages.map((pkg, i) => (
          <li class:list={['plan', { 'is-popular': pkg.popular }]} data-reveal data-glow style={`--delay: ${i * 90}ms`}>
            <div class="plan-top">
              <Sub class="plan-name">{pkg.name}</Sub>
              {pkg.popular && <span class="popular">Most popular</span>}
            </div>
            <p class="price">
              <span class="from">from</span>
              {showOffer ? (
                <>
                  <del>
                    <span class="visually-hidden">was </span>
                    {formatPrice(pkg.price)}
                  </del>
                  <span class="now">
                    <span class="visually-hidden">now </span>
                    {formatPrice(offerPrice(pkg.price))}
                  </span>
                </>
              ) : (
                <span class="now">{formatPrice(pkg.price)}</span>
              )}
            </p>
            <p class="best">{pkg.bestFor}</p>
            <ul class="features">
              {pkg.features.map((feature) => (
                <li>
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m5 10.5 3 3 7-7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <div class="care" data-reveal>
      <div class="care-intro">
        <Sub class="care-title">Care plans</Sub>
        <p>Optional upkeep so your site stays secure and current. Cancel any time with a month's notice.</p>
      </div>
      <ul class="care-list">
        {
          carePlans.map((plan) => (
            <li>
              <p class="care-name">
                {plan.name} <span class="care-price">{formatPrice(plan.monthly)}<small>/month</small></span>
              </p>
              <p class="care-text">{plan.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

  </div>
</section>

<script>
  // Desktop only: a soft glow follows the cursor around each price card.
  // Sets --mx/--my on the card; the CSS draws the glow with a radial gradient.
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-glow]').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const box = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${event.clientX - box.left}px`);
        card.style.setProperty('--my', `${event.clientY - box.top}px`);
      });
    });
  }
</script>

<style>
  .head .section-head {
    margin-bottom: var(--space-m);
  }

  /* ---------- Founding offer banner ---------- */
  .offer {
    position: relative;
    display: grid;
    gap: 0.4rem 1rem;
    padding: 1rem 1.1rem;
    margin-bottom: var(--space-l);
    border: 1px solid rgb(255 122 89 / 0.45);
    border-radius: var(--radius);
    background: linear-gradient(100deg, rgb(255 122 89 / 0.2), rgb(255 122 89 / 0.06) 70%), var(--ink-raised);
    overflow: hidden;
  }
  .offer-badge {
    justify-self: start;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--coral);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .offer-text {
    color: var(--chalk);
  }
  .offer-text strong {
    color: var(--peach);
  }
  .offer-spots {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--mist);
  }
  .pips {
    display: inline-flex;
    gap: 0.3rem;
  }
  .pip {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1.5px solid var(--peach);
  }
  .pip.is-free {
    background: var(--coral);
    border-color: var(--coral);
  }

  /* ---------- Packages ---------- */
  .plans {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }
  /* Phone: compact rows, name on the left and price on the right. */
  .plan {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0 var(--space-s);
    padding: 1rem 1.1rem;
    border: 1px solid var(--ink-line);
    border-radius: var(--radius);
    background: var(--ink-raised);
    transition:
      transform 0.4s var(--ease-out),
      border-color 0.3s;
  }
  .plan.is-popular {
    border-color: var(--kiwi);
    background: radial-gradient(ellipse 90% 60% at 100% 0%, rgb(155 225 93 / 0.14), transparent 70%), var(--ink-raised);
  }
  .plan-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 0.5rem;
  }
  .best {
    display: none;
  }
  .plan-name {
    font-size: var(--step-1);
  }
  .popular {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--kiwi);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 700;
    white-space: nowrap;
  }

  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 0.5rem;
  }
  .from {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--mist);
  }
  .price del {
    font-size: var(--step-0);
    color: var(--mist);
    text-decoration-color: var(--coral);
    text-decoration-thickness: 2px;
  }
  .now {
    font-family: var(--font-heading);
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1;
    color: var(--chalk);
    font-variant-numeric: tabular-nums;
  }
  /* Phone: features as one short dotted line under the name and price. */
  .features {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.4rem;
    margin-top: 0.4rem;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--mist);
  }
  .features li:not(:last-child)::after {
    content: '·';
    margin-left: 0.4rem;
    color: var(--kiwi);
  }
  .features svg {
    display: none;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.1rem;
    fill: none;
    stroke: var(--kiwi);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Care plans ---------- */
  .care {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-s);
    padding: 1rem 1.1rem;
    border: 1px dashed var(--ink-line);
    border-radius: var(--radius);
  }
  .care-title {
    font-size: var(--step-1);
  }
  .care-intro p {
    margin-top: 0.25rem;
    color: var(--mist);
    font-size: var(--step--1);
  }
  .care-list {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }
  .care-name {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-weight: 700;
  }
  .care-price {
    font-family: var(--font-heading);
    color: var(--lime);
  }
  .care-price small {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--mist);
  }
  .care-text {
    color: var(--mist);
    font-size: var(--step--1);
  }

  /* ---------- Wider screens ---------- */
  @media (min-width: 40rem) {
    .care-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-m);
    }
    .offer {
      grid-template-columns: auto 1fr auto;
      align-items: center;
    }
  }

  @media (min-width: 56rem) {
    .head {
      display: grid;
      grid-template-columns: 1fr 22rem;
      gap: var(--space-l);
      align-items: end;
      margin-bottom: var(--space-l);
    }
    .head .section-head {
      margin-bottom: 0;
    }
    .offer {
      grid-template-columns: 1fr;
      margin-bottom: 0;
      padding: 1.25rem 1.4rem;
    }
    .plans {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-m);
    }
    .plan {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-m);
    }
    .price {
      justify-content: flex-start;
      margin-top: 0.35rem;
    }
    .now {
      font-size: var(--step-3);
    }
    .best {
      display: block;
      margin-top: 0.5rem;
      color: var(--mist);
      font-size: var(--step--1);
    }
    .features {
      display: grid;
      gap: 0.3rem;
      margin-top: var(--space-s);
      padding-top: var(--space-s);
      border-top: 1px solid var(--ink-line);
      color: var(--chalk);
    }
    .features li {
      display: flex;
      gap: 0.45rem;
      align-items: flex-start;
    }
    .features li::after {
      display: none;
    }
    .features svg {
      display: block;
    }
    .plan:hover {
      transform: translateY(-6px);
      border-color: var(--kiwi);
    }
    .plan.is-popular {
      box-shadow: 0 0 0 1px var(--kiwi), 0 24px 60px -30px rgb(155 225 93 / 0.5);
    }
    .care {
      grid-template-columns: 16rem 1fr;
      align-items: center;
      gap: var(--space-l);
    }
  }

  /* Cursor glow on the card border (desktop with a mouse only). */
  @media (min-width: 56rem) and (hover: hover) and (pointer: fine) {
    .plan::before {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      padding: 1px;
      background: radial-gradient(
        14rem circle at var(--mx, 50%) var(--my, 0%),
        rgb(155 225 93 / 0.9),
        rgb(255 122 89 / 0.35) 40%,
        transparent 70%
      );
      mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }
    .plan::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(18rem circle at var(--mx, 50%) var(--my, 0%), rgb(155 225 93 / 0.08), transparent 70%);
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }
    .plan:hover::before,
    .plan:hover::after {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Desktop only: the free places gently pulse. */
    @media (min-width: 56rem) {
      .pip.is-free {
        animation: pulse 2.4s ease-in-out infinite;
      }
    }
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 4px rgb(255 122 89 / 0.25);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plan {
      transition: none;
    }
  }
</style>
