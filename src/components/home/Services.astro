---
/**
 * What I do: the four services, as cards. Edit the `services` list to change them.
 * Each icon is a small inline SVG path drawn on a 24×24 grid.
 */
const services = [
  {
    tag: '<new />',
    title: 'New websites',
    text: "A proper website for a business that doesn't have one yet, or only has a Facebook page. Clear, quick to load and easy for local customers to find.",
    icon: 'M3 5.5A2.5 2.5 0 0 1 5.5 3h13A2.5 2.5 0 0 1 21 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5zM3 8h18M12 11.5v6M9 14.5h6',
  },
  {
    tag: '<refresh />',
    title: 'Website refreshes',
    text: "Got a site that looks dated or is awkward to use on a phone? I'll rebuild it so it looks current, loads fast and works on every screen.",
    icon: 'M20 12a8 8 0 0 1-14.3 4.9M4 12A8 8 0 0 1 18.3 7.1M18.5 3v4.3h-4.3M5.5 21v-4.3h4.3',
  },
  {
    tag: '<setup />',
    title: 'Domains and hosting',
    text: "Domains and hosting can be a headache. I'll set it all up for you in your own name, with any fees paid straight from your own accounts, so you always own your site.",
    icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3.5 9h17M3.5 15h17M12 3c-2.4 2.6-3.6 5.6-3.6 9s1.2 6.4 3.6 9c2.4-2.6 3.6-5.6 3.6-9S14.4 5.6 12 3z',
  },
  {
    tag: '<update />',
    title: 'Updates and help',
    text: 'New opening hours, a seasonal menu or fresh photos. Simple changes handled for you, so your site stays up to date without the hassle.',
    icon: 'M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4zM13.5 6.5l4 4',
  },
];
---

<section id="services" class="section theme-light" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">What I do</p>
      <h2 id="services-title">Everything your business needs to look good online</h2>
      <p>From a brand-new site to keeping your current one ticking over, all handled by one person you can talk to.</p>
    </div>

    <ul class="cards">
      {
        services.map((service, i) => (
          <li class="card" data-reveal style={`--delay: ${i * 90}ms`}>
            <div class="card-top">
              <span class="icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={service.icon} />
                </svg>
              </span>
              <code class="tag">{service.tag}</code>
            </div>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cards {
    display: grid;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }
  .card {
    position: relative;
    padding: var(--space-l) var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      border-color 0.3s;
  }
  /* Kiwi-green bar that sweeps across the top on hover. */
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--leaf), var(--kiwi));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: transparent;
  }
  .card:hover::before {
    transform: scaleX(1);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-m);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.9rem;
    background: var(--ink);
    color: var(--kiwi);
    transition: transform 0.5s var(--ease-spring);
  }
  .card:hover .icon {
    transform: rotate(-8deg) scale(1.08);
  }
  .icon svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  h3 {
    margin-bottom: var(--space-xs);
  }
  .card p {
    color: var(--muted);
  }

  @media (min-width: 44rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
