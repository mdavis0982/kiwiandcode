---
/**
 * FAQ list built on native <details>, so it works with keyboard, screen
 * readers and no JavaScript. Answers slide open where the browser supports
 * animating to auto height; the plus turns into a minus.
 *
 * Pass `items` as { q, a } pairs. Answers are plain text.
 */
interface Props {
  items: { q: string; a: string }[];
  eyebrow?: string;
  title?: string;
}

const { items, eyebrow = 'Questions', title = 'Questions people ask' } = Astro.props;
---

<section class="section theme-light faq" aria-labelledby="faq-title">
  <div class="container faq-layout">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="faq-title">{title}</h2>
    </div>

    <div class="faq-list">
      {
        items.map((item, i) => (
          <details class="faq-item" data-reveal style={`--delay: ${i * 60}ms`}>
            <summary>
              <span class="faq-q">{item.q}</span>
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: grid;
    gap: 0.6rem;
  }
  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color 0.25s,
      background-color 0.25s;
  }
  .faq-item[open] {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--paper-raised) 85%, var(--lime));
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 3.25rem;
    padding: 0.85rem 1.1rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--step-0);
    border-radius: var(--radius);
  }
  summary::-webkit-details-marker {
    display: none;
  }

  /* Plus that turns into a minus: the vertical bar rotates flat. */
  .faq-icon {
    position: relative;
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--ink);
    transition: transform 0.35s var(--ease-out);
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.8rem;
    height: 2px;
    margin: -1px 0 0 -0.4rem;
    border-radius: 2px;
    background: var(--kiwi);
    transition: transform 0.35s var(--ease-out);
  }
  .faq-icon::after {
    transform: rotate(90deg);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-icon::after {
    transform: rotate(0deg);
  }
  summary:hover .faq-icon {
    transform: scale(1.08);
  }
  .faq-item[open] summary:hover .faq-icon {
    transform: rotate(180deg) scale(1.08);
  }

  .faq-a {
    padding: 0 1.1rem 1.1rem;
    color: var(--stone);
    max-width: 60ch;
  }

  /* Smooth open and close, where supported (Chromium for now). */
  @media (prefers-reduced-motion: no-preference) {
    .faq-item::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 0.4s var(--ease-out),
        content-visibility 0.4s allow-discrete;
    }
    .faq-item[open]::details-content {
      block-size: auto;
    }
  }

  @media (min-width: 56rem) {
    .faq-layout {
      display: grid;
      grid-template-columns: 20rem 1fr;
      gap: var(--space-l);
      align-items: start;
    }
    .faq-layout .section-head {
      position: sticky;
      top: 7rem;
    }
  }
</style>
