---
/**
 * The Kiwi and Code mark (a kiwi slice cut in two by a "/") as inline SVG.
 *
 * Props:
 *  - animated: plays the intro animation (used once, in the hero).
 *  - label:    accessible name. Leave empty when the mark sits next to the
 *              "Kiwi and Code" wordmark, so screen readers don't hear it twice.
 *  - class:    extra classes for sizing from the parent.
 */
import { center, colors, cut, radius, seeds, seedSize, viewBox } from '../lib/kiwiMark';

interface Props {
  animated?: boolean;
  label?: string;
  class?: string;
}

const { animated = false, label = '', class: className = '' } = Astro.props;
const { x, y } = center;
const { x: dx, y: dy } = cut.offset;

// The mark appears several times per page, so each copy needs its own clip ids.
const uid = `km-${Math.random().toString(36).slice(2, 8)}`;
const halves = [
  { key: 'a', clip: `${uid}-l`, points: cut.left, shift: `translate(${-dx} ${-dy})` },
  { key: 'b', clip: `${uid}-r`, points: cut.right, shift: `translate(${dx} ${dy})` },
];
---

<svg
  class:list={['kiwi-mark', className, { 'is-animated': animated }]}
  viewBox={viewBox}
  xmlns="http://www.w3.org/2000/svg"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <defs>
    {
      halves.map((h) => (
        <clipPath id={h.clip}>
          <polygon points={h.points} />
        </clipPath>
      ))
    }
  </defs>

  <g class="km-mark">
    {
      halves.map((h) => (
        // Outer <g> carries the CSS animation; the inner one keeps the clip and gap offset.
        <g class={`km-half km-half--${h.key}`}>
          <g clip-path={`url(#${h.clip})`} transform={h.shift}>
            <circle cx={x} cy={y} r={radius.skin} fill={colors.skin} />
            <circle cx={x} cy={y} r={radius.flesh} fill={colors.kiwi} />
            <circle class="km-ring" cx={x} cy={y} r={radius.ring} fill={colors.lime} />
            <circle class="km-core" cx={x} cy={y} r={radius.core} fill={colors.paper} />
            <g fill={colors.ink}>
              {seeds.map((s, i) => (
                <g class="km-seed" style={`--i:${i}`}>
                  <ellipse
                    cx={s.cx}
                    cy={s.cy}
                    rx={seedSize.rx}
                    ry={seedSize.ry}
                    transform={`rotate(${s.rotate} ${s.cx} ${s.cy})`}
                  />
                </g>
              ))}
            </g>
          </g>
        </g>
      ))
    }
  </g>
</svg>

<style>
  .kiwi-mark {
    display: block;
    overflow: visible;
  }

  /* Scale SVG parts around their own centres. */
  .km-mark,
  .km-seed,
  .km-ring,
  .km-core {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Small hover flourish, used by the header logo link: the halves part. */
  .km-half {
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  :global(a:hover) > .kiwi-mark .km-half--a,
  :global(a:focus-visible) > .kiwi-mark .km-half--a {
    transform: translate(-4px, -0.8px);
  }
  :global(a:hover) > .kiwi-mark .km-half--b,
  :global(a:focus-visible) > .kiwi-mark .km-half--b {
    transform: translate(4px, 0.8px);
  }

  /* ---------- Hero intro animation ---------- */
  /* The halves slide in from opposite ends of the cut, then the middle and
     seeds pop in, then the halves gently breathe apart and back. */
  @media (prefers-reduced-motion: no-preference) {
    .is-animated .km-half--a {
      animation:
        km-in-a 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both,
        km-breathe-a 4s ease-in-out 1.6s infinite;
    }
    .is-animated .km-half--b {
      animation:
        km-in-b 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both,
        km-breathe-b 4s ease-in-out 1.6s infinite;
    }
    .is-animated .km-ring {
      animation: km-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s both;
    }
    .is-animated .km-core {
      animation: km-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.75s both;
    }
    .is-animated .km-seed {
      animation: km-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      animation-delay: calc(0.85s + var(--i) * 0.045s);
    }
  }

  @keyframes km-in-a {
    from {
      opacity: 0;
      transform: translate(-14px, 64px);
    }
    to {
      opacity: 1;
      transform: translate(0, 0);
    }
  }
  @keyframes km-in-b {
    from {
      opacity: 0;
      transform: translate(14px, -64px);
    }
    to {
      opacity: 1;
      transform: translate(0, 0);
    }
  }
  @keyframes km-breathe-a {
    50% {
      transform: translate(-3px, -0.6px);
    }
  }
  @keyframes km-breathe-b {
    50% {
      transform: translate(3px, 0.6px);
    }
  }
  @keyframes km-pop {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
