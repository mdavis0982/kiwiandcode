---
/**
 * The Kiwi and Code mark (kiwi slice between < > brackets) as inline SVG.
 *
 * Props:
 *  - animated: plays the intro animation (used once, in the hero).
 *  - label:    accessible name. Leave empty when the mark sits next to the
 *              "Kiwi and Code" wordmark, so screen readers don't hear it twice.
 *  - class:    extra classes for sizing from the parent.
 */
import { brackets, center, colors, radius, rays, seeds, viewBox } from '../lib/kiwiMark';

interface Props {
  animated?: boolean;
  label?: string;
  class?: string;
}

const { animated = false, label = '', class: className = '' } = Astro.props;
const { x, y } = center;
---

<svg
  class:list={['kiwi-mark', className, { 'is-animated': animated }]}
  viewBox={viewBox}
  xmlns="http://www.w3.org/2000/svg"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <g
    class="km-brackets"
    fill="none"
    stroke={colors.kiwi}
    stroke-width={brackets.width}
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path class="km-bracket km-bracket--left" d={brackets.left} />
    <path class="km-bracket km-bracket--right" d={brackets.right} />
  </g>

  <g class="km-slice">
    <circle cx={x} cy={y} r={radius.skin} fill={colors.skin} />
    <circle cx={x} cy={y} r={radius.flesh} fill={colors.kiwi} />
    <g class="km-rays" stroke={colors.ray} stroke-width="5" stroke-linecap="round">
      {rays.map((r) => <line x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2} />)}
    </g>
    <circle class="km-ring" cx={x} cy={y} r={radius.ring} fill={colors.ring} />
    <circle class="km-core" cx={x} cy={y} r={radius.core} fill={colors.core} />
    <g fill={colors.seed}>
      {
        seeds.map((s, i) => (
          // Wrapper <g> carries the CSS animation; the ellipse keeps its own rotation.
          <g class="km-seed" style={`--i:${i}`}>
            <ellipse cx={s.cx} cy={s.cy} rx="7" ry="12" transform={`rotate(${s.rotate} ${s.cx} ${s.cy})`} />
          </g>
        ))
      }
    </g>
  </g>
</svg>

<style>
  .kiwi-mark {
    display: block;
    overflow: visible;
  }

  /* Rotate and scale SVG parts around their own centres. */
  .km-slice,
  .km-bracket,
  .km-seed,
  .km-ring,
  .km-core {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Small hover flourish, used by the header logo link. */
  :global(a:hover) > .kiwi-mark .km-slice,
  :global(a:focus-visible) > .kiwi-mark .km-slice {
    transform: rotate(45deg);
  }
  .km-slice {
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* ---------- Hero intro animation ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .is-animated .km-slice {
      animation:
        km-slice-in 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both,
        km-spin 90s linear 1.4s infinite;
    }
    .is-animated .km-ring {
      animation: km-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.45s both;
    }
    .is-animated .km-core {
      animation: km-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s both;
    }
    .is-animated .km-seed {
      animation: km-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      animation-delay: calc(0.75s + var(--i) * 0.035s);
    }
    .is-animated .km-bracket--left {
      animation:
        km-bracket-left 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both,
        km-breathe-left 4s ease-in-out 1.6s infinite;
    }
    .is-animated .km-bracket--right {
      animation:
        km-bracket-right 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both,
        km-breathe-right 4s ease-in-out 1.6s infinite;
    }
  }

  @keyframes km-slice-in {
    from {
      opacity: 0;
      transform: scale(0.4) rotate(-120deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
  @keyframes km-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes km-pop {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes km-bracket-left {
    from {
      opacity: 0;
      transform: translateX(120px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes km-bracket-right {
    from {
      opacity: 0;
      transform: translateX(-120px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes km-breathe-left {
    50% {
      transform: translateX(-10px);
    }
  }
  @keyframes km-breathe-right {
    50% {
      transform: translateX(10px);
    }
  }
</style>
