---
/**
 * Shell for the example sites in src/pages/examples/. Each example is a
 * made-up business with its own look, so this layout leaves out the Kiwi and
 * Code header, footer and global styles. It keeps a slim ribbon at the top
 * that says it's an example design and links back home.
 *
 * Example pages are kept out of search results (noindex) so a made-up
 * business never shows up as if it were real.
 */
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Social share image. Falls back to the Kiwi and Code one. */
  ogImage?: string;
}

const { title, description, ogImage = site.ogImage } = Astro.props;
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Social sharing, so a shared example link still gets a proper preview. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <aside class="kc-ribbon" aria-label="About this example">
      <p>
        <span class="kc-dot" aria-hidden="true"></span>
        Example design by <a href="/">{site.name}</a>. This business is made up.
      </p>
      <a class="kc-back" href="/#examples">&larr; Back to examples</a>
    </aside>
    <slot />

    <script>
      // Scroll reveal for [data-reveal], same idea as the main site.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        items.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  * {
    margin: 0;
  }
  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    min-height: 100dvh;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img,
  svg {
    display: block;
    max-width: 100%;
  }
  button {
    font: inherit;
  }

  .js [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--delay, 0ms);
  }
  .js [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
  /* Cross-fade from the homepage, and morph the example card into this hero. */
  @view-transition {
    navigation: auto;
  }
  ::view-transition-group(*.example) {
    animation-duration: 0.55s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }
  ::view-transition-old(*.example),
  ::view-transition-new(*.example) {
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  ::view-transition-old(*.example):only-child {
    animation-duration: 0.25s;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* ---------- Kiwi and Code ribbon ---------- */
  .kc-ribbon {
    position: relative;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0 clamp(1rem, 0.5rem + 2.5vw, 2.5rem);
    background: #0d1b14;
    color: #f5f3ea;
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: 0.85rem;
  }
  .kc-ribbon a {
    color: #d4f5a8;
    text-underline-offset: 0.2em;
  }
  /* Inline padding makes the in-sentence link a bigger target without changing the line height. */
  .kc-ribbon p a {
    padding-block: 0.75rem;
  }
  .kc-back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem; /* 44px tap target */
    font-weight: 600;
    text-decoration: none;
  }
  .kc-back:hover {
    text-decoration: underline;
  }
  .kc-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: #9be15d;
    vertical-align: 0.05em;
  }
</style>
