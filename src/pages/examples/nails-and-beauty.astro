---
/**
 * Example site: Maison Lacquer, a made-up nail and beauty studio. A one-page
 * demo, polished and a little luxe: shimmering headline, a fan of polish
 * bottles, a "try a shade" set of press-on nails you can repaint in different finishes,
 * a nail-art gallery drawn in CSS and a sparkle burst on the booking button.
 *
 * Everything about the business (name, town, prices, reviews) is invented.
 */
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/jost/wght.css';
import ExampleLayout from '../../layouts/ExampleLayout.astro';

const shades = [
  { name: 'Cherry Bomb', hex: '#B3122E' },
  { name: 'Ballet Slipper', hex: '#F2C4CE' },
  { name: 'Midnight Plum', hex: '#4A1739' },
  { name: 'Champagne', hex: '#E8CBA8' },
  { name: 'Sage Leaf', hex: '#9CAF88' },
  { name: 'Ocean Mist', hex: '#6F9FB8' },
  { name: 'Classic Nude', hex: '#D9A889' },
  { name: 'Black Velvet', hex: '#1B1418' },
];
const finishes = ['Gloss', 'Matte', 'Chrome', 'Glitter'];

// Press-on nails for the shade preview, left to right: width and tilt.
// They fan out from a shared baseline, tallest in the middle.
const tips = [
  { w: 38, tilt: -16 },
  { w: 44, tilt: -8 },
  { w: 48, tilt: 0 },
  { w: 44, tilt: 8 },
  { w: 38, tilt: 16 },
].map((t, i, all) => {
  const gap = 10;
  const total = all.reduce((sum, n) => sum + n.w, 0) + gap * (all.length - 1);
  const before = all.slice(0, i).reduce((sum, n) => sum + n.w + gap, 0);
  return { ...t, h: t.w * 1.95, cx: (300 - total) / 2 + before + t.w / 2 };
});
// An almond nail shape, w wide and h tall, with its tip at the top and a
// rounded cuticle end at the bottom.
const nail = (w: number, h: number) =>
  `M0 ${h * 0.9}V${h * 0.48}C0 ${h * 0.18} ${w * 0.34} 0 ${w / 2} 0S${w} ${h * 0.18} ${w} ${h * 0.48}V${h * 0.9}Q${w / 2} ${h * 1.06} 0 ${h * 0.9}Z`;

const bottles = ['#B3122E', '#F2C4CE', '#4A1739', '#E8CBA8', '#C99A7A'];

const ticker = ['Gel manicures', 'BIAB', 'Nail art', 'Lash lifts', 'Brow lamination', 'Pedicures', 'Facials'];

type Group = 'nails' | 'lashes' | 'beauty';
const groups: { id: Group; label: string }[] = [
  { id: 'nails', label: 'Nails' },
  { id: 'lashes', label: 'Lashes & brows' },
  { id: 'beauty', label: 'Beauty' },
];
const treatments: { name: string; note: string; time: string; price: string; group: Group }[] = [
  { name: 'Gel manicure', note: 'Shape, cuticle care and a long-lasting gel colour.', time: '45 min', price: '£28', group: 'nails' },
  { name: 'BIAB overlay', note: 'Builder gel for strong, natural-looking nails.', time: '60 min', price: '£35', group: 'nails' },
  { name: 'Nail art', note: 'French tips, chrome, foils or freehand designs.', time: 'from 10 min', price: 'from £5', group: 'nails' },
  { name: 'Luxury pedicure', note: 'Soak, scrub, massage and gel polish.', time: '60 min', price: '£38', group: 'nails' },
  { name: 'Lash lift & tint', note: 'Curled, darker lashes for six to eight weeks.', time: '50 min', price: '£40', group: 'lashes' },
  { name: 'Brow lamination', note: 'Fluffy, brushed-up brows, shaped and tinted.', time: '45 min', price: '£38', group: 'lashes' },
  { name: 'Brow wax & tint', note: 'Clean shape and soft definition.', time: '25 min', price: '£18', group: 'lashes' },
  { name: 'Glow facial', note: 'Cleanse, exfoliate and a hydrating mask.', time: '60 min', price: '£45', group: 'beauty' },
  { name: 'Spray tan', note: 'A natural, streak-free glow, mixed for your skin.', time: '20 min', price: '£25', group: 'beauty' },
];

const gallery = [
  { name: 'Soft French', style: 'french' },
  { name: 'Milky marble', style: 'marble' },
  { name: 'Pink ombré', style: 'ombre' },
  { name: 'Aura chrome', style: 'chrome' },
  { name: 'Gold foil', style: 'foil' },
  { name: 'Polka dot', style: 'dots' },
];

const reviews = [
  { quote: 'My nails have never looked this good. Three weeks in and not a single chip.', name: 'Rachel' },
  { quote: "The most relaxing hour of my month. I'd move in if they let me.", name: 'Orla' },
  { quote: 'Brought a blurry Pinterest photo and walked out with something even better.', name: 'Jess' },
];
---

<ExampleLayout
  title="Maison Lacquer | Nail and beauty studio | Example website"
  description="An example nail and beauty salon homepage designed by Kiwi and Code. Maison Lacquer is a made-up business."
>
  <div class="ml">
    <header class="nav">
      <a class="brand" href="#top">Maison <em>Lacquer</em></a>
      <nav aria-label="Main">
        <a href="#shades">Shades</a>
        <a href="#treatments">Treatments</a>
        <a href="#gallery">Gallery</a>
      </nav>
      <a class="btn btn--small" href="#book">Book now</a>
    </header>

    <main id="top">
      <!-- ---------- Hero ---------- -->
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Nail &amp; beauty studio · Lisnacree</p>
          <h1>
            <span class="h-line" style="--i: 0">Nails that</span>
            <span class="h-line" style="--i: 1"><em class="shimmer">do the talking.</em></span>
          </h1>
          <p class="lead">
            Gel, BIAB, nail art, lashes and brows, done beautifully in a calm little studio on Main Street, Lisnacree.
          </p>
          <div class="actions">
            <a class="btn" href="#book">Book an appointment</a>
            <a class="btn btn--ghost" href="#shades">Try a shade</a>
          </div>
        </div>

        <div class="hero-art" aria-hidden="true">
          <div class="arch"></div>
          <div class="fan">
            {
              bottles.map((c, i) => (
                <div class="bottle" style={`--c: ${c}; --i: ${i}; --n: ${bottles.length}`}>
                  <span class="cap" />
                  <span class="glass" />
                </div>
              ))
            }
          </div>
          <span class="sparkle sp1">✦</span>
          <span class="sparkle sp2">✦</span>
          <span class="sparkle sp3">✧</span>
        </div>
      </section>

      <!-- ---------- Ticker ---------- -->
      <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
          {
            [0, 1].map(() => (
              <p>
                {ticker.map((item) => (
                  <span>
                    {item} <b>✦</b>
                  </span>
                ))}
              </p>
            ))
          }
        </div>
      </div>

      <!-- ---------- Try a shade ---------- -->
      <section id="shades" class="section shades">
        <div class="shades-copy" data-reveal>
          <p class="eyebrow">Try before you book</p>
          <h2>Find your <em>shade</em></h2>
          <p class="muted">Pick a colour and a finish to see it on. Just a taste of our 200+ shades in the studio.</p>

          <fieldset class="picker">
            <legend>Colour: <strong data-shade-name>{shades[0].name}</strong></legend>
            <div class="swatches">
              {
                shades.map((s, i) => (
                  <button
                    type="button"
                    class="swatch"
                    style={`--c: ${s.hex}`}
                    data-shade={s.hex}
                    data-name={s.name}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={s.name}
                  />
                ))
              }
            </div>
          </fieldset>

          <fieldset class="picker">
            <legend>Finish</legend>
            <div class="finishes">
              {
                finishes.map((f, i) => (
                  <button type="button" class="finish" data-finish={f.toLowerCase()} aria-pressed={i === 0 ? 'true' : 'false'}>
                    {f}
                  </button>
                ))
              }
            </div>
          </fieldset>
        </div>

        <div class="preview-wrap" data-reveal style="--delay: 120ms">
          <svg
            class="preview finish-gloss"
            data-preview
            viewBox="0 0 300 200"
            style={`--shade: ${shades[0].hex}`}
            role="img"
            aria-label="Five press-on nails showing the chosen shade and finish"
          >
            <defs>
              <linearGradient id="ml-chrome" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#fff" stop-opacity=".85" />
                <stop offset=".35" stop-color="#fff" stop-opacity="0" />
                <stop offset=".6" stop-color="#fff" stop-opacity=".45" />
                <stop offset="1" stop-color="#fff" stop-opacity="0" />
              </linearGradient>
              <pattern id="ml-glitter" width="9" height="9" patternUnits="userSpaceOnUse">
                <circle cx="2" cy="2" r="1.1" fill="#fff" opacity=".9" />
                <circle cx="6.5" cy="5" r=".8" fill="#ffe7b8" />
                <circle cx="3.5" cy="7.5" r=".6" fill="#fff" opacity=".7" />
              </pattern>
            </defs>
            <ellipse class="tip-shadow" cx="150" cy="182" rx="120" ry="8" />
            {
              tips.map((t, i) => (
                // Outer <g> carries the CSS animation; the inner one places and tilts the nail.
                <g class="tip" style={`--i: ${i}`}>
                  <g transform={`translate(${t.cx} 176) rotate(${t.tilt}) translate(${-t.w / 2} ${-t.h})`}>
                    <path class="polish" d={nail(t.w, t.h)} />
                    <path class="chrome" d={nail(t.w, t.h)} />
                    <path class="glitter" d={nail(t.w, t.h)} />
                    <path
                      class="shine"
                      d={`M${t.w * 0.27} ${t.h * 0.7}V${t.h * 0.42}C${t.w * 0.27} ${t.h * 0.24} ${t.w * 0.35} ${t.h * 0.13} ${t.w * 0.44} ${t.h * 0.08}`}
                    />
                  </g>
                </g>
              ))
            }
          </svg>
          <p class="preview-label" aria-hidden="true">Press-on preview</p>
        </div>
      </section>

      <!-- ---------- Treatments ---------- -->
      <section id="treatments" class="section section--plum">
        <div class="inner">
          <div class="section-head" data-reveal>
            <p class="eyebrow eyebrow--light">The menu</p>
            <h2>Treatments &amp; <em>prices</em></h2>
          </div>

          <div class="tabs" role="tablist" aria-label="Treatment types" data-reveal>
            {
              groups.map((g, i) => (
                <button
                  type="button"
                  role="tab"
                  class="tab"
                  id={`tab-${g.id}`}
                  data-tab={g.id}
                  aria-controls={`panel-${g.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {g.label}
                </button>
              ))
            }
          </div>

          {
            groups.map((g, i) => (
              <div role="tabpanel" id={`panel-${g.id}`} aria-labelledby={`tab-${g.id}`} hidden={i !== 0}>
                <ul class="menu">
                {treatments
                  .filter((t) => t.group === g.id)
                  .map((t, j) => (
                    <li style={`--j: ${j}`}>
                      <div class="menu-row">
                        <h3>{t.name}</h3>
                        <span class="leader" aria-hidden="true" />
                        <p class="price">{t.price}</p>
                      </div>
                      <p class="menu-note">
                        {t.note} <span class="time">{t.time}</span>
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ---------- Gallery ---------- -->
      <section id="gallery" class="section">
        <div class="section-head section-head--center" data-reveal>
          <p class="eyebrow">Recent sets</p>
          <h2>Little works of <em>art</em></h2>
        </div>
        <ul class="gallery">
          {
            gallery.map((g, i) => (
              <li class={`set set--${g.style}`} data-reveal style={`--delay: ${(i % 3) * 90}ms`}>
                <div class="set-nails" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </div>
                <p>{g.name}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ---------- Reviews ---------- -->
      <section class="section reviews-section">
        <ul class="reviews">
          {
            reviews.map((r, i) => (
              <li data-reveal style={`--delay: ${i * 120}ms`}>
                <p class="stars" aria-label="5 out of 5 stars">✦ ✦ ✦ ✦ ✦</p>
                <blockquote>“{r.quote}”</blockquote>
                <p class="reviewer">{r.name}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ---------- Book ---------- -->
      <section id="book" class="book">
        <div class="book-inner" data-reveal>
          <p class="eyebrow eyebrow--light">Treat yourself</p>
          <h2>Your next set <em>starts here.</em></h2>
          <p>Tuesday to Saturday, 9am to 7pm. Late appointments on Thursdays.</p>
          <button type="button" class="btn btn--light" data-book>Book an appointment</button>
          <p class="book-note" data-book-note hidden>This is an example site, so there's no real booking. Enjoy the sparkle.</p>
        </div>
        <div class="burst" data-burst aria-hidden="true"></div>
      </section>
    </main>

    <footer class="foot">
      <p class="foot-brand">Maison <em>Lacquer</em></p>
      <p>12 Main Street, Lisnacree, County Down</p>
    </footer>
  </div>

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---------- Try a shade ----------
    const preview = document.querySelector<SVGElement>('[data-preview]');
    const shadeName = document.querySelector<HTMLElement>('[data-shade-name]');
    const swatches = document.querySelectorAll<HTMLButtonElement>('[data-shade]');
    const finishBtns = document.querySelectorAll<HTMLButtonElement>('[data-finish]');

    swatches.forEach((btn) =>
      btn.addEventListener('click', () => {
        swatches.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        preview?.style.setProperty('--shade', btn.dataset.shade ?? '');
        if (shadeName) shadeName.textContent = btn.dataset.name ?? '';
      }),
    );
    finishBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        finishBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        if (!preview) return;
        preview.classList.forEach((c) => c.startsWith('finish-') && preview.classList.remove(c));
        preview.classList.add(`finish-${btn.dataset.finish}`);
      }),
    );

    // ---------- Treatment tabs ----------
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      // Arrow keys move between tabs, as screen reader users expect.
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });

    // ---------- Sparkle burst on the booking button ----------
    const bookBtn = document.querySelector<HTMLButtonElement>('[data-book]');
    const bookNote = document.querySelector<HTMLElement>('[data-book-note]');
    const burst = document.querySelector<HTMLElement>('[data-burst]');

    bookBtn?.addEventListener('click', () => {
      if (bookNote) bookNote.hidden = false;
      if (!burst || reduceMotion) return;
      const btnBox = bookBtn.getBoundingClientRect();
      const box = burst.getBoundingClientRect();
      const x = btnBox.left + btnBox.width / 2 - box.left;
      const y = btnBox.top + btnBox.height / 2 - box.top;
      for (let i = 0; i < 40; i++) {
        const star = document.createElement('i');
        const angle = Math.random() * Math.PI * 2;
        const dist = 90 + Math.random() * 200;
        star.textContent = i % 3 ? '✦' : '✧';
        star.style.left = `${x}px`;
        star.style.top = `${y}px`;
        star.style.fontSize = `${0.7 + Math.random() * 1.2}rem`;
        star.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
        star.style.setProperty('--dy', `${Math.sin(angle) * dist}px`);
        burst.append(star);
        star.addEventListener('animationend', () => star.remove());
      }
    });
  </script>
</ExampleLayout>

<style>
  .ml {
    --cream: #fff8f4;
    --blush: #f7e1e3;
    --blush-deep: #eccbcf;
    --plum: #3b1424;
    --plum-soft: #6e4a58;
    --berry: #a3284f;
    --gold: #c99a7a;
    --gold-light: #f1d9c3;
    --serif: 'Playfair Display Variable', Georgia, serif;
    --sans: 'Jost Variable', ui-sans-serif, system-ui, sans-serif;
    --gutter: clamp(1rem, 0.5rem + 2.5vw, 2.5rem);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    background: var(--cream);
    color: var(--plum);
    font-family: var(--sans);
    font-size: clamp(1.02rem, 0.98rem + 0.2vw, 1.14rem);
    overflow-x: clip;
  }
  .ml :is(h1, h2, h3) {
    font-family: var(--serif);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .ml em {
    font-style: italic;
    color: var(--berry);
  }
  .ml :focus-visible {
    outline: 2px solid var(--berry);
    outline-offset: 3px;
  }
  .muted {
    color: var(--plum-soft);
  }
  .eyebrow {
    margin-bottom: 1rem;
    color: var(--berry);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  .eyebrow--light {
    color: var(--gold-light);
  }

  /* ---------- Buttons ---------- */
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.75rem;
    border: 1px solid var(--plum);
    border-radius: 999px;
    background: var(--plum);
    color: var(--cream);
    font-family: var(--sans);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    transition:
      transform 0.3s var(--spring),
      box-shadow 0.3s var(--ease);
  }
  /* A sheen that sweeps across the button on hover. */
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.35) 50%, transparent 70%);
    transform: translateX(-120%);
    transition: transform 0.7s var(--ease);
  }
  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -14px var(--plum);
  }
  .btn:hover::after {
    transform: translateX(120%);
  }
  .btn--ghost {
    background: transparent;
    color: var(--plum);
  }
  .btn--small {
    padding: 0.55rem 1.2rem;
    font-size: 0.9rem;
  }
  .btn--light {
    border-color: var(--cream);
    background: var(--cream);
    color: var(--plum);
  }

  /* ---------- Nav ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem var(--gutter);
    background: color-mix(in srgb, var(--cream) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--blush-deep);
  }
  .brand {
    color: var(--plum);
    font-family: var(--serif);
    font-size: 1.45rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav nav {
    display: none;
    gap: 2rem;
  }
  .nav nav a {
    color: var(--plum-soft);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav nav a:hover {
    color: var(--berry);
  }
  @media (min-width: 52rem) {
    .nav nav {
      display: flex;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    align-items: center;
    gap: 2.5rem;
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 1rem + 5vw, 5.5rem) var(--gutter) clamp(3rem, 2rem + 5vw, 6rem);
  }
  .hero h1 {
    font-size: clamp(3rem, 1.6rem + 6vw, 6.5rem);
  }
  .h-line {
    display: block;
    animation: unveil 1.1s var(--ease) both;
    animation-delay: calc(var(--i) * 180ms + 100ms);
  }
  @keyframes unveil {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
      transform: translateY(0.4em);
    }
    to {
      clip-path: inset(-0.2em -0.2em -0.3em -0.2em);
    }
  }
  /* Rose-gold shimmer that slides through the italic words. */
  .shimmer {
    background: linear-gradient(100deg, var(--berry) 0%, var(--berry) 35%, var(--gold) 45%, #f6dcc6 50%, var(--gold) 55%, var(--berry) 65%, var(--berry) 100%)
      0 0 / 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent !important;
    padding-right: 0.1em;
    animation: shimmer 5s ease-in-out 1.2s infinite;
  }
  @keyframes shimmer {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: -50% 0;
    }
  }
  .lead {
    max-width: 30rem;
    margin-top: 1.5rem;
    color: var(--plum-soft);
    font-size: 1.15em;
    animation: fade 0.9s var(--ease) 0.7s both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
    animation: fade 0.9s var(--ease) 0.85s both;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* Arch + fan of polish bottles */
  .hero-art {
    position: relative;
    display: grid;
    place-items: end center;
    width: min(100%, 26rem);
    aspect-ratio: 4 / 5;
    margin: 0 auto;
  }
  .arch {
    position: absolute;
    inset: 0;
    border-radius: 999px 999px 1.5rem 1.5rem;
    background:
      radial-gradient(circle at 50% 30%, #fff 0, transparent 60%),
      linear-gradient(180deg, var(--blush), var(--blush-deep));
    animation: rise 1.1s var(--ease) 0.2s both;
  }
