---
/**
 * Example site: Little Loaf Bakehouse, a made-up bakery. It's a one-page demo
 * to show what a small bakery's homepage could look like, so it's
 * deliberately a bit showy: rising headline, floating bakes, a live "open now"
 * badge and a countdown to the next tray out of the oven.
 *
 * Everything about the business (name, town, prices, hours) is invented.
 */
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/inter/wght.css';
import ExampleLayout from '../../layouts/ExampleLayout.astro';

// Hand-drawn bakes, used in the hero and on the menu cards. Decorative only.
const bakes = {
  loaf: `<svg viewBox="0 0 100 100"><ellipse cx="50" cy="74" rx="38" ry="6" fill="#2b1810" opacity=".12"/><path d="M12 64C12 28 88 28 88 64v4c0 5-76 5-76 0z" fill="#c8813f"/><path d="M12 64c0 5 76 5 76 0" fill="none" stroke="#9a5420" stroke-width="2"/><path d="M28 50q8-9 16-5M44 44q8-9 16-5M60 48q7-7 13-3" fill="none" stroke="#f6dcae" stroke-width="3.5" stroke-linecap="round"/></svg>`,
  croissant: `<svg viewBox="0 0 100 100"><ellipse cx="50" cy="76" rx="36" ry="5" fill="#2b1810" opacity=".12"/><g fill="#d48a3c" stroke="#9a5420" stroke-width="2"><ellipse cx="20" cy="64" rx="10" ry="7" transform="rotate(-50 20 64)"/><ellipse cx="80" cy="64" rx="10" ry="7" transform="rotate(50 80 64)"/><ellipse cx="33" cy="50" rx="13" ry="10" transform="rotate(-30 33 50)"/><ellipse cx="67" cy="50" rx="13" ry="10" transform="rotate(30 67 50)"/><ellipse cx="50" cy="44" rx="16" ry="13"/></g><path d="M42 38q8-4 16 0" fill="none" stroke="#f6c37a" stroke-width="3" stroke-linecap="round"/></svg>`,
  swirl: `<svg viewBox="0 0 100 100"><ellipse cx="50" cy="84" rx="30" ry="5" fill="#2b1810" opacity=".12"/><circle cx="50" cy="54" r="32" fill="#d9944d"/><path d="M50 54a4 4 0 0 1 8 0a8 8 0 0 1-16 0a12 12 0 0 1 24 0a16 16 0 0 1-32 0a20 20 0 0 1 40 0a24 24 0 0 1-48 0" fill="none" stroke="#7a3e16" stroke-width="3.5" stroke-linecap="round"/><path d="M28 40l10 8 8-10 10 9 8-9 10 8" fill="none" stroke="#fff8ee" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  traybake: `<svg viewBox="0 0 100 100"><ellipse cx="50" cy="80" rx="34" ry="5" fill="#2b1810" opacity=".12"/><rect x="18" y="58" width="64" height="20" rx="3" fill="#e9c27e"/><rect x="18" y="48" width="64" height="12" fill="#c87d2e"/><path d="M18 50v-8q0-4 4-4h56q4 0 4 4v8q-4 4-8 0t-8 2-8-2-8 2-8-2-8 2-8-2-8 2-8 0z" fill="#4a2616"/><circle cx="30" cy="68" r="1.6" fill="#c99a5a"/><circle cx="50" cy="72" r="1.6" fill="#c99a5a"/><circle cx="68" cy="66" r="1.6" fill="#c99a5a"/></svg>`,
  cake: `<svg viewBox="0 0 100 100"><ellipse cx="50" cy="82" rx="32" ry="5" fill="#2b1810" opacity=".12"/><rect x="22" y="44" width="56" height="34" rx="4" fill="#f3d29a"/><rect x="22" y="59" width="56" height="5" fill="#c2364f"/><path d="M22 46q0-8 8-8h40q8 0 8 8v2q-6 4-12 0-6 5-12 0-6 5-12 0-6 5-12 0-4 3-8 0z" fill="#fff3e3"/><circle cx="50" cy="31" r="7" fill="#d9304a"/><path d="M46 24l4 4 4-4" fill="none" stroke="#3f7a2a" stroke-width="2.5" stroke-linecap="round"/></svg>`,
  farl: `<svg viewBox="0 0 100 100"><ellipse cx="48" cy="80" rx="34" ry="5" fill="#2b1810" opacity=".12"/><path d="M18 76V30a46 46 0 0 1 46 46z" fill="#e8c48e" stroke="#c99a5a" stroke-width="2"/><g fill="#fffaf0"><circle cx="30" cy="52" r="2"/><circle cx="42" cy="62" r="1.6"/><circle cx="28" cy="68" r="1.4"/><circle cx="46" cy="48" r="1.2"/><circle cx="54" cy="68" r="1.8"/></g></svg>`,
};

type Category = 'bread' | 'pastry' | 'sweet';

const menu: { name: string; note: string; price: string; cat: Category; icon: keyof typeof bakes; tag?: string }[] = [
  { name: 'Country sourdough', note: 'A slow 48-hour rise, a crackly crust and a soft, open middle.', price: '£4.50', cat: 'bread', icon: 'loaf', tag: 'Best seller' },
  { name: 'Wheaten bread', note: 'The Irish classic, made with buttermilk and wholemeal.', price: '£3.20', cat: 'bread', icon: 'loaf' },
  { name: 'Soda farls', note: 'Griddled every morning. Made for an Ulster fry.', price: '£2.40 for 4', cat: 'bread', icon: 'farl' },
  { name: 'Butter croissant', note: 'Three days of folding, 27 flaky layers, real French butter.', price: '£2.20', cat: 'pastry', icon: 'croissant' },
  { name: 'Cinnamon swirl', note: 'Brown sugar, cinnamon and a vanilla icing drizzle.', price: '£2.80', cat: 'pastry', icon: 'swirl', tag: 'Gone by 11' },
  { name: 'Pain au chocolat', note: 'Our croissant dough wrapped around two bars of dark chocolate.', price: '£2.50', cat: 'pastry', icon: 'croissant' },
  { name: "Millionaire's shortbread", note: 'Buttery shortbread, soft caramel, a thick snap of chocolate.', price: '£2.60', cat: 'sweet', icon: 'traybake' },
  { name: 'Fifteens', note: 'Digestives, marshmallows and cherries, rolled in coconut.', price: '£2.40', cat: 'sweet', icon: 'traybake' },
  { name: 'Victoria sponge', note: 'Light sponge, raspberry jam and fresh cream, by the slice.', price: '£3.50', cat: 'sweet', icon: 'cake' },
];

const filters: { id: 'all' | Category; label: string }[] = [
  { id: 'all', label: 'Everything' },
  { id: 'bread', label: 'Bread' },
  { id: 'pastry', label: 'Pastries' },
  { id: 'sweet', label: 'Sweet treats' },
];

const ticker = ['Sourdough', 'Cinnamon swirls', 'Wheaten bread', 'Croissants', 'Fifteens', 'Soda farls', 'Traybakes', 'Celebration cakes'];

// Opening hours, Monday first. Times are 24-hour "HH:MM". null means closed.
// The script below reads this to show "Open now" and highlight today.
const hours: { day: string; open: string | null; close: string | null }[] = [
  { day: 'Monday', open: null, close: null },
  { day: 'Tuesday', open: '07:30', close: '16:00' },
  { day: 'Wednesday', open: '07:30', close: '16:00' },
  { day: 'Thursday', open: '07:30', close: '16:00' },
  { day: 'Friday', open: '07:30', close: '16:00' },
  { day: 'Saturday', open: '08:00', close: '15:00' },
  { day: 'Sunday', open: '09:00', close: '13:00' },
];

const stats = [
  { value: 48, suffix: 'h', label: 'to rise every sourdough loaf' },
  { value: 4, suffix: 'am', label: 'when the first oven goes on' },
  { value: 100, suffix: '%', label: 'real butter, never margarine' },
];

const headline = ['Baked', 'before', "you're"];
---

<ExampleLayout
  title="Little Loaf Bakehouse | Example bakery website"
  description="An example bakery homepage designed by Kiwi and Code. Little Loaf Bakehouse is a made-up business."
>
  <div class="bakery">
    <header class="nav">
      <a class="brand" href="#top">
        <span class="brand-mark" aria-hidden="true" set:html={bakes.loaf} />
        Little Loaf
      </a>
      <nav aria-label="Main">
        <a href="#bakes">Bakes</a>
        <a href="#story">Our story</a>
        <a href="#visit">Visit</a>
      </nav>
      <a class="btn btn--small" href="#visit">Order ahead</a>
    </header>

    <main id="top">
      <!-- ---------- Hero ---------- -->
      <section class="hero">
        <div class="hero-copy">
          <p class="status" data-status hidden>
            <span class="status-dot"></span>
            <span data-status-text></span>
          </p>
          <h1>
            {
              headline.map((word, i) => (
                <>
                  <span class="word" style={`--i: ${i}`}>
                    {word}
                  </span>{' '}
                </>
              ))
            }
            <em class="word" style={`--i: ${headline.length}`}>awake.</em>
          </h1>
          <p class="lead">
            Sourdough, flaky croissants and proper Irish traybakes, made from scratch every morning on Main Street,
            Ballyfern.
          </p>
          <div class="actions">
            <a class="btn" href="#bakes">
              See today's bakes
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            <a class="btn btn--ghost" href="#visit">Find us</a>
          </div>
        </div>

        <div class="hero-art" aria-hidden="true">
          <div class="plate"></div>
          <svg class="badge" viewBox="0 0 200 200">
            <defs>
              <path id="badge-circle" d="M100 100m-74 0a74 74 0 1 1 148 0a74 74 0 1 1-148 0" />
            </defs>
            <text><textPath href="#badge-circle" textLength="460" lengthAdjust="spacing">Fresh every morning · Baked since 4am ·</textPath></text>
          </svg>
          <div class="float float--loaf">
            <div class="steam"><i></i><i></i><i></i></div>
            <Fragment set:html={bakes.loaf} />
          </div>
          <div class="float float--croissant" set:html={bakes.croissant} />
          <div class="float float--swirl" set:html={bakes.swirl} />
          <div class="float float--cake" set:html={bakes.cake} />
          <span class="sprinkle s1"></span>
          <span class="sprinkle s2"></span>
          <span class="sprinkle s3"></span>
          <span class="sprinkle s4"></span>
        </div>
      </section>

      <!-- ---------- Ticker ---------- -->
      <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
          {
            [0, 1].map(() => (
              <p>
                {ticker.map((item) => (
                  <span>
                    {item} <b>✺</b>
                  </span>
                ))}
              </p>
            ))
          }
        </div>
      </div>

      <!-- ---------- Bakes ---------- -->
      <section id="bakes" class="section">
        <div class="section-head" data-reveal>
          <p class="eyebrow">On the counter today</p>
          <h2>Something for <em>every</em> kind of morning</h2>
        </div>

        <div class="oven" data-reveal data-oven hidden>
          <span class="oven-icon" aria-hidden="true">🔥</span>
          <p>
            Next tray out of the oven in <strong data-oven-time>--:--</strong>
          </p>
        </div>

        <div class="filters" role="group" aria-label="Filter bakes" data-reveal>
          {
            filters.map((f, i) => (
              <button type="button" class="filter" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {f.label}
              </button>
            ))
          }
        </div>

        <ul class="menu">
          {
            menu.map((item, i) => (
              <li class="card" data-cat={item.cat} data-reveal style={`--delay: ${(i % 3) * 90}ms`}>
                <div class="card-art" aria-hidden="true" set:html={bakes[item.icon]} />
                {item.tag && <span class="tag">{item.tag}</span>}
                <div class="card-body">
                  <h3>{item.name}</h3>
                  <p>{item.note}</p>
                </div>
                <p class="price">{item.price}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ---------- Story ---------- -->
      <section id="story" class="story">
        <div class="story-inner">
          <blockquote data-reveal>
            <p>
              “We started with one oven and my granny's wheaten recipe. Ten years on, the oven's bigger, but the recipe hasn't
              changed a bit.”
            </p>
            <footer>Aoife, owner and head baker</footer>
          </blockquote>

          <ul class="stats">
            {
              stats.map((s, i) => (
                <li data-reveal style={`--delay: ${i * 120}ms`}>
                  <p class="stat">
                    <span data-count={s.value}>{s.value}</span>
                    {s.suffix}
                  </p>
                  <p>{s.label}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ---------- Visit ---------- -->
      <section id="visit" class="section visit">
        <div class="visit-copy" data-reveal>
          <p class="eyebrow">Come and see us</p>
          <h2>Follow the smell of <em>fresh bread</em></h2>
          <p class="address">14 Main Street, Ballyfern, County Down</p>
          <p class="small">Order cakes and big bread orders 48 hours ahead, in the shop or by phone.</p>

          <table class="hours">
            <caption class="visually-hidden">Opening hours</caption>
            <tbody>
              {
                hours.map((h, i) => (
                  <tr data-day={i}>
                    <th scope="row">{h.day}</th>
                    <td>{h.open ? `${h.open} – ${h.close}` : 'Closed'}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="map" data-reveal style="--delay: 120ms" aria-hidden="true">
          <svg viewBox="0 0 400 320">
            <rect width="400" height="320" fill="#efe2c9" />
            <path d="M-10 210C80 190 150 240 240 200s140-30 180-20" fill="none" stroke="#9cc2c9" stroke-width="22" stroke-linecap="round" />
            <g fill="none" stroke="#fbf4e8" stroke-width="14" stroke-linecap="round">
              <path d="M0 120h400" />
              <path d="M150 0v320" />
              <path d="M290 0l-40 320" />
              <path d="M0 40l150 80" />
            </g>
            <g fill="#dccaa6">
              <rect x="20" y="140" width="110" height="40" rx="6" />
              <rect x="170" y="20" width="90" height="80" rx="6" />
              <rect x="300" y="20" width="80" height="80" rx="6" />
              <rect x="170" y="140" width="80" height="40" rx="6" />
              <rect x="20" y="250" width="110" height="50" rx="6" />
              <rect x="300" y="240" width="90" height="60" rx="6" />
            </g>
            <circle cx="70" cy="70" r="26" fill="#b9c99a" />
            <circle cx="100" cy="85" r="16" fill="#b9c99a" />
          </svg>
          <div class="pin">
            <span class="pin-pulse"></span>
            <span class="pin-head" set:html={bakes.croissant} />
          </div>
          <p class="map-label">Little Loaf</p>
        </div>
      </section>
    </main>

    <footer class="foot">
      <p class="foot-big">Little <em>Loaf</em></p>
      <p>14 Main Street, Ballyfern · Tuesday to Sunday</p>
    </footer>
  </div>

  <script>
    // ---------- Menu filters ----------
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.card');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const cat = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        cards.forEach((card) => {
          card.hidden = cat !== 'all' && card.dataset.cat !== cat;
        });
      }),
    );

    // ---------- Open now / today's hours ----------
    // Reads the hours table, so changing the hours in the page data is enough.
    const rows = document.querySelectorAll<HTMLTableRowElement>('.hours tr');
    const toMinutes = (t: string) => {
      const [h, m] = t.split(':').map(Number);
      return h * 60 + m;
    };
    const now = new Date();
    const today = (now.getDay() + 6) % 7; // Monday = 0
    const minutes = now.getHours() * 60 + now.getMinutes();
    const todayRow = rows[today];
    todayRow?.classList.add('is-today');

    const [open, close] = (todayRow?.querySelector('td')?.textContent ?? '').split(' – ');
    const isOpen = Boolean(close) && minutes >= toMinutes(open) && minutes < toMinutes(close);

    const status = document.querySelector<HTMLElement>('[data-status]');
    const statusText = document.querySelector<HTMLElement>('[data-status-text]');
    if (status && statusText) {
      statusText.textContent = isOpen ? `Open now, until ${close}` : 'Closed right now. See our hours below';
      status.classList.toggle('is-open', isOpen);
      status.hidden = false;
    }

    // ---------- Next tray countdown ----------
    // While the shop is open, a fresh tray comes out every half hour.
    const oven = document.querySelector<HTMLElement>('[data-oven]');
    const ovenTime = document.querySelector<HTMLElement>('[data-oven-time]');
    if (isOpen && oven && ovenTime) {
      oven.hidden = false;
      const tick = () => {
        const d = new Date();
        const secs = 1800 - ((d.getMinutes() % 30) * 60 + d.getSeconds());
        ovenTime.textContent = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
      };
      tick();
      setInterval(tick, 1000);
    }

    // ---------- Count-up stats ----------
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion && 'IntersectionObserver' in window) {
      const countObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            const target = Number(el.dataset.count);
            const start = performance.now();
            const step = (t: number) => {
              const p = Math.min((t - start) / 1400, 1);
              el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
            countObserver.unobserve(el);
          }
        },
        { threshold: 0.6 },
      );
      counters.forEach((el) => {
        el.textContent = '0';
        countObserver.observe(el);
      });
    }
  </script>
</ExampleLayout>

<style>
  .bakery {
    --flour: #fbf4e8;
    --dough: #f3e3c8;
    --crust: #b8662a;
    --crust-deep: #8a4513;
    --cocoa: #2b1810;
    --cocoa-soft: #5c4334;
    --berry: #c8364e;
    --butter: #f6c453;
    --sage: #4f6b2e;
    --serif: 'Fraunces Variable', Georgia, serif;
    --sans: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    --gutter: clamp(1rem, 0.5rem + 2.5vw, 2.5rem);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    background: var(--flour);
    color: var(--cocoa);
    font-family: var(--sans);
    font-size: clamp(1rem, 0.97rem + 0.15vw, 1.1rem);
    overflow-x: clip;
  }
  .bakery :is(h1, h2, h3) {
    font-family: var(--serif);
    font-variation-settings:
      'SOFT' 100,
      'WONK' 1;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .bakery em {
    font-style: italic;
    color: var(--berry);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- Buttons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border: 2px solid var(--cocoa);
    border-radius: 999px;
    background: var(--cocoa);
    color: var(--flour);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--butter);
    transition:
      transform 0.25s var(--spring),
      box-shadow 0.25s var(--spring);
  }
  .btn svg {
    width: 1.1rem;
    transition: transform 0.25s var(--spring);
  }
  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--butter);
  }
  .btn:hover svg {
    transform: translateX(3px);
  }
  .btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--butter);
  }
  .btn--ghost {
    background: transparent;
    color: var(--cocoa);
    box-shadow: none;
  }
  .btn--ghost:hover {
    background: var(--dough);
    box-shadow: none;
  }
  .btn--small {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    box-shadow: 3px 3px 0 var(--butter);
  }
  .bakery :focus-visible {
    outline: 3px solid var(--berry);
    outline-offset: 3px;
  }

  /* ---------- Nav ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem var(--gutter);
    background: color-mix(in srgb, var(--flour) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--cocoa) 10%, transparent);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--cocoa);
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 700;
    font-variation-settings: 'SOFT' 100;
    text-decoration: none;
  }
  .brand-mark {
    display: block;
    width: 2.2rem;
    transition: transform 0.4s var(--spring);
  }
  .brand:hover .brand-mark {
    transform: rotate(-12deg) scale(1.1);
  }
  .nav nav {
    display: none;
    gap: 1.75rem;
  }
  .nav nav a {
    color: var(--cocoa-soft);
    font-weight: 500;
    text-decoration: none;
    background: linear-gradient(var(--berry), var(--berry)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s var(--ease);
  }
  .nav nav a:hover {
    color: var(--cocoa);
    background-size: 100% 2px;
  }
  @media (min-width: 48rem) {
    .nav nav {
      display: flex;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    align-items: center;
    gap: 2rem;
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(2rem, 1rem + 5vw, 5rem) var(--gutter) clamp(3rem, 2rem + 5vw, 6rem);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--dough);
    color: var(--cocoa-soft);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .status-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--cocoa-soft);
  }
  .status.is-open {
    color: var(--sage);
  }
  .status.is-open .status-dot {
    background: #5e9e2f;
    box-shadow: 0 0 0 0 rgb(94 158 47 / 0.6);
    animation: ping 1.8s infinite;
  }
  @keyframes ping {
    70%,
    100% {
