// Cloudflare Workers config: serves the built static site from dist/.
// Cloudflare runs `npm run build`, then `npx wrangler deploy` uploads dist/.
{
  "name": "kiwiandcode",
  "compatibility_date": "2026-10-01",
  // Small script that redirects www to the bare domain (see worker/index.js).
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Let the script see every request first, so the www redirect always runs.
    "run_worker_first": true,
    // Show src/pages/404.astro for unknown URLs.
    "not_found_handling": "404-page"
  },
  // Contact form emails go out through Email Routing, only ever to this verified inbox.
  "send_email": [{ "name": "SEND_EMAIL", "destination_address": "kiwiandcode@gmail.com" }],
  // Lets Cloudflare build preview versions of non-main branches (`wrangler preview`).
  "previews": {},
  // The bare domain is the site's real address; www is routed here only to redirect.
  "routes": [
    { "pattern": "kiwiandcode.co.uk", "custom_domain": true },
    { "pattern": "www.kiwiandcode.co.uk/*", "zone_name": "kiwiandcode.co.uk" }
  ]
}
